# Groq-compatible OpenAI API. Leave blank until you obtain your Groq API key.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Local corpus/index settings
OPEN_INDIA_LAW_DIR=./data/open_india_law
CONSTITUTION_DIR=./data/constitution
DATABASE_PATH=./data/nyaya_mitra.sqlite3
TOP_K=8

# Conversational AI request budget (seconds; retries are separate attempts)
LLM_CHAT_TIMEOUT_SECONDS=45
LLM_CHAT_MAX_RETRIES=0
